# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 运行产物（可随时重新生成，不入库） ----------
logs/
results/
runs/
outputs/
*.log

# ---------- 数据集：大文件与自动生成部分不入库 ----------
dataset/all/
dataset/embedding_cache/

# ---------- 模型权重：二进制大文件默认不入库 ----------
# 唯一例外是 ADAPT 基线默认权重，主流程默认加载它，必须随仓库分发
*.pt
*.pth
*.ckpt
!network_dismantling/ADAPT/checkpoints/adaptive_best.pt

# 训练检查点与训练曲线（src/train/v1 下全部视为本地产物）
src/train/v1/checkpoints/*.pth
src/train/v1/checkpoints/*.pt
src/train/v1/checkpoints/*.ckpt
src/train/v1/checkpoints/*training_history.csv
src/train/v1/*.png

# ---------- 归档区：历史权重 / 历史日志 / 一次性实验产物 ----------
# 目录在本地保留，只做收纳，不进版本库（详见 archive/README.md）
# 例外：归档说明与清单文件要入库，便于追溯"什么被归档了"
archive/**
!archive/README.md
!archive/*.csv

# ---------- 系统与编辑器杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ---------- 本地协作工具产生的私有数据（不随仓库分发） ----------
.workbuddy/
